# phone-hold-detector configuration
# Copy this file to `.env` and fill in real values for your machine.
# `.env` is gitignored — real paths and keys never get committed.

# --- Capture ---
# Local webcam device index (0 = Mac built-in camera),
# or later a stream URL, e.g. http://<pi-ip>:8080/stream (Phase 5)
CAMERA_SOURCE=0

# --- Model weights (paths relative to project root) ---
# Pretrained segmentation model (Ultralytics downloads it on first use)
SEG_MODEL_PATH=models/yolo11n-seg.pt
# The phone detector you train in Phase 3
PHONE_MODEL_PATH=models/phone_detector.pt

# --- Roboflow (Phase 3: dataset labeling & hosting) ---
ROBOFLOW_API_KEY=your-key-here
